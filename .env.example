# ============================================================================
# DOZOR — Конфигурация окружения
# ============================================================================
#
# ЛОКАЛЬНЫЙ ЗАПУСК (без HTTPS, без Let's Encrypt):
#   Скопируй этот файл в .env и раскомментируй строку ниже.
#   Caddy будет работать по HTTP на http://localhost
#
#     DOMAIN=localhost
#
#
# ПРОДАКШЕН (с HTTPS, Let's Encrypt):
#   Укажи реальный домен, на который указывает DNS сервера.
#   Порты 80 и 443 должны быть доступны из интернета.
#   На хосте не должно быть других веб-серверов (nginx/apache) на этих портах.
#
#     DOMAIN=app-dozor.ru
#
# ============================================================================

# DOMAIN=localhost

# Telegram Bot
TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TG_CHAT_ID=123456789
