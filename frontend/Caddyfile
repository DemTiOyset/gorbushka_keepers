# Caddyfile.
# Домен берётся из переменной окружения DOMAIN (см. docker-compose).
# Caddy автоматически:
#   1. Выпускает сертификат Let's Encrypt для указанного домена
#   2. Редиректит HTTP → HTTPS
#   3. Обновляет сертификат в фоне за 30 дней до истечения
#
# Локально (DOMAIN=localhost) — Caddy работает без TLS, чтобы не падать
# при попытке выпустить сертификат для localhost.
#
# Для прода: проверь что порты 80 и 443 доступны из интернета и DNS указывает
# на этот сервер. Если на хосте уже есть nginx/apache на 80/443 — сначала
# останови их.

{$DOMAIN:localhost} {
	encode gzip

	# API проксируется на FastAPI, префикс /api стрипается через handle_path
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# SPA: отдаём статику, для клиентского роутинга fallback на index.html.
	# handle { ... } гарантирует что запросы к /api/* (уже обработанные выше)
	# никогда не дойдут до file_server — он отдаёт 405 на POST.
	#
	# ACME-челленджи и HTTP→HTTPS редирект Caddy добавляет ПЕРЕД
	# пользовательскими handle-блоками, поэтому они не затрагиваются.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
