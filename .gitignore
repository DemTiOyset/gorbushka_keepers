# ============================================================================
# Dozor — Git Ignore Rules
# ============================================================================

# --- Окружение и секреты ---
.env
.env.local
.env.*.local
!.env.example

# --- Python: байткод и кэши ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Python: виртуальные окружения и пакеты ---
.venv/
venv/
ENV/
env/
.uv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python: тестирование, профилирование и линтеры ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.pyre/

# --- Node.js / Frontend кэши и зависимости ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
bun.lock

# --- Логи и базы данных ---
*.log
*.sqlite
*.sqlite3
*.db

# --- Системные файлы и IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
